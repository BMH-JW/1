%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 194dc37d64cdead44b908bf4aa309ce3, type: 3}
  m_Name: DailyEventConfig
  m_EditorClassIdentifier: 
  orderDanger:
  - "\u4EBA\u754C\u9632\u7EBF\u5F7B\u5E95\u5931\u5B88\uFF01\u6210\u7FA4\u7684\u6076\u7075\u987A\u7740\u88C2\u7F1D\u6D8C\u5165\uFF0C\u54C0\u568E\u58F0\u5DF2\u7ECF\u76D6\u8FC7\u4E86\u7559\u58F0\u673A\u7684\u58F0\u97F3\u3002\u5929\u5E73\u6B63\u5728\u75AF\u72C2\u9707\u52A8\uFF0C\u518D\u63A5\u7740\u4E0B\u964D\uFF0C\u8FD9\u91CC\u5C31\u4F1A\u88AB\u5F7B\u5E95\u6495\u788E\uFF01"
  orderCriticalLow:
  - "\u591A\u4E2A\u6781\u7AEF\u6559\u6D3E\u5728\u4EBA\u754C\u8857\u5934\u5174\u8D77\uFF0C\u4ED6\u4EEC\u5BA3\u79F0'\u96FE\u7684\u5C3D\u5934\u662F\u6551\u8D4E'\uFF0C\u5E76\u8BD5\u56FE\u51B2\u7834\u8FB9\u754C\u8FDB\u5165\u4E4C\u6258\u90A6\u3002\u8BF7\u5BA1\u6279\u4EBA\u5458\u4FDD\u6301\u8B66\u60D5\uFF0C\u8FD9\u4E9B\u72C2\u70ED\u5206\u5B50\u5F80\u5F80\u4F34\u968F\u7740\u6781\u9AD8\u7684\u98CE\u9669\u503C\u3002"
  orderLow:
  - "\u7D27\u6025\u63D2\u64AD\uFF1A\u4EBA\u754C\u897F\u533A\u7684\u5730\u4E0B\u9ED1\u5E02\u53D1\u751F\u6076\u6027\u6597\u6BB4\u4E8B\u4EF6\uFF0C\u73B0\u573A\u6B8B\u7559\u5927\u91CF\u72C2\u66B4\u7684\u7075\u9B42\u7C92\u5B50\u3002\u8BF7\u5404\u4F4D\u5C45\u6C11\u591C\u95F4\u9501\u597D\u95E8\u7A97\uFF0C\u5207\u52FF\u9760\u8FD1\u5E9F\u5F03\u94C1\u8DEF\u3002"
  - "\u8B66\u62A5\uFF0C\u4EBA\u754C\u7684\u94C1\u9508\u5473\u5DF2\u7ECF\u987A\u7740\u7F1D\u9699\u98D8\u8FDB\u5BA1\u6279\u7AD9\u4E86\u3002\u591A\u5904\u5730\u4E0B\u6C34\u5F00\u59CB\u6CB8\u817E\uFF0C\u6D3B\u4EBA\u7684\u66B4\u8E81\u60C5\u7EEA\u6B63\u5728\u8513\u5EF6\u3002"
  orderNormal:
  - "\u4ECA\u65E5\u51CC\u6668\uFF0C\u4EBA\u754C\u4E1C\u533A\u53D1\u751F\u8F7B\u5FAE\u7684\u5730\u8109\u9707\u52A8\uFF0C\u5E76\u672A\u9020\u6210\u4EBA\u5458\u4F24\u4EA1\u3002"
  - "\u5C45\u6C11\u4EEC\u8868\u793A\uFF0C\u6700\u8FD1\u591C\u95F4\u7684\u602A\u58F0\u4F3C\u4E4E\u51CF\u5C11\u4E86\uFF0C\u611F\u8C22\u59D4\u6258\u6240\u7684\u4E25\u683C\u628A\u5173\u3002"
  - "\u57CE\u90CA\u7684\u5E9F\u5F03\u5DE5\u5382\u53C8\u53D1\u751F\u4E86\u4E24\u8D77\u5E2E\u6D3E\u706B\u62FC\u3002\u5730\u8109\u9707\u611F\u6BD4\u6628\u65E5\u5F3A\u70C8\u4E860.1\u7EA7\uFF0C\u51E0\u4E2A\u559D\u9189\u7684\u6D3B\u4EBA\u58F0\u79F0\u5728\u96FE\u91CC\u770B\u5230\u4E86\u957F\u89D2\u7684\u5F71\u5B50\u3002"
  - "\u4E00\u4F4D\u8001\u5987\u4EBA\u4ECA\u65E5\u5728\u59D4\u6258\u6240\u95E8\u5916\u7559\u4E0B\u4E86\u4E00\u675F\u767D\u82B1\u3002\u5979\u6CA1\u6709\u9012\u4EA4\u4EFB\u4F55\u7533\u8BF7\uFF0C\u53EA\u662F\u5BF9\u7740\u7D27\u95ED\u7684\u5927\u95E8\u97A0\u4E86\u4E00\u8EAC\uFF0C\u968F\u540E\u6D88\u5931\u5728\u96FE\u4E2D\u3002"
  orderHigh:
  - "\u968F\u7740\u8FB9\u754C\u7684\u7A33\u5B9A\uFF0C\u8D8A\u6765\u8D8A\u591A\u7684\u6D3B\u4EBA\u5F00\u59CB\u5411\u59D4\u6258\u6240\u732E\u4E0A\u7948\u7977\u3002\u867D\u7136\u4ED6\u4EEC\u4E0D\u77E5\u9053\u95E8\u540E\u662F\u8C01\uFF0C\u4F46\u90A3\u76CF\u660F\u9EC4\u7684\u6CB9\u706F\uFF0C\u6210\u4E86\u4ED6\u4EEC\u5FC3\u4E2D\u7684\u4E00\u4E2A\u951A\u70B9\u3002"
  purityDanger:
  - "\u7075\u589F\u7684\u767D\u5149\u5DF2\u7ECF\u53D8\u6210\u4E86\u523A\u773C\u7684\u60E8\u767D\u3002\u90A3\u4E9B\u88AB\u6C61\u67D3\u7684\u53D8\u5F02\u4F53\u6B63\u5728\u540C\u5316\u4E00\u5207\u3002\u6839\u636E\u4E0A\u5C42\u7814\u7A76\uFF0C\u5982\u679C\u7075\u9B42\u8FDB\u4E00\u6B65\u6D51\u6D4A\uFF0C\u8FD9\u4E2A\u4E16\u754C\u5C06\u4E0D\u518D\u6709\u751F\u4E0E\u6B7B\u7684\u754C\u9650\uFF0C\u5168\u90E8\u90FD\u4F1A\u53D8\u6210\u75AF\u5B50\u3002\""
  purityCriticalLow:
  - "\u4ECA\u65E5\uFF0C\u4EBA\u754C\u5357\u90E8\u7684\u4E00\u7247\u9EA6\u7530\u7A81\u7136\u67AF\u840E\uFF0C\u571F\u58E4\u4E2D\u6E17\u51FA\u9ED1\u8272\u7684\u7C98\u7A20\u6DB2\u4F53\u3002\u521D\u6B65\u8C03\u67E5\u663E\u793A\uFF0C\u8FD9\u53EF\u80FD\u662F\u7531\u4E8E\u5927\u91CF\u672A\u51C0\u5316\u7684\u6076\u7075\u6C14\u606F\u6E17\u5165\u5730\u8868\u6240\u81F4\u3002"
  purityLow:
  - "\u96FE\u7684\u6D53\u5EA6\u4ECA\u65E5\u6025\u5267\u4E0A\u5347\u3002\u591A\u540D\u8DE8\u754C\u8005\u53CD\u6620\uFF0C\u5728\u8D70\u5ECA\u4E2D\u542C\u5230\u4E86\u4E0D\u5C5E\u4E8E\u81EA\u5DF1\u7684\u4F4E\u8BED\u58F0\u3002\u5FC3\u7406\u5B66\u4E13\u5BB6\u63D0\u9192\uFF1A\u8FD9\u53EF\u80FD\u662F\u6781\u5EA6\u7126\u8651\u5F15\u53D1\u7684\u96C6\u4F53\u5E7B\u89C9"
  - "\u7531\u4E8E\u7269\u7406\u58C1\u5792\u53D8\u5F97\u8584\u5F31\uFF0C\u90E8\u5206\u7406\u667A\u4E0D\u6E05\u7684\u4EA1\u9B42\u5F00\u59CB\u5F3A\u884C\u51B2\u51FB\u5927\u95E8\u3002"
  - "\u4E4C\u6258\u90A6\u7684\u76D1\u6D4B\u5854\u53D1\u51FA\u523A\u8033\u8702\u9E23\u3002\u6C34\u8D28\u5F00\u59CB\u53D8\u5F97\u6D51\u6D4A\uFF0C\u7A7A\u6C14\u4E2D\u5F25\u6F2B\u7740\u4E00\u79CD\u4EE4\u4EBA\u4E0D\u5B89\u7684\u4EBA\u60C5\u5473\u3002"
  purityNormal:
  - "\u4ECA\u5929\u96FE\u7684\u989C\u8272\u6709\u4E9B\u53D1\u7070\u3002\u6709\u5C45\u6C11\u6295\u8BC9\uFF0C\u6628\u591C\u68A6\u89C1\u4E86\u4E00\u4E9B\u4E0D\u8BE5\u68A6\u5230\u7684\u751F\u524D\u5F80\u4E8B\u3002\u8BF7\u6CE8\u610F\uFF0C\u54EA\u6015\u662F\u5FAE\u5C0F\u7684\u601C\u60AF\uFF0C\u4E5F\u662F\u6C61\u67D3\u7684\u5F00\u59CB\u3002"
  - "\u4ECA\u65E5\u5DE1\u903B\u961F\u6C47\u62A5\uFF0C\u8FB9\u754C\u88C2\u7F1D\u7684\u7269\u7406\u58C1\u5792\u5B8C\u597D\u3002\u5C45\u6C11\u53CD\u9988\uFF0C\u6700\u8FD1\u7075\u9B42\u4E71\u7A9C\u7684\u602A\u4E8B\u5C11\u4E86\u5F88\u591A\uFF0C\u7EC8\u4E8E\u80FD\u7761\u4E2A\u5B89\u7A33\u89C9\u4E86\u3002"
  - "\u7075\u589F\u6C14\u8C61\u76D1\u6D4B\u5C40\u53D1\u5E03\u62A5\u544A\uFF0C\u4ECA\u65E5\u8DE8\u5883\u5C18\u57C3\u6307\u6570\u4E0B\u964D\u4E860.03%\u3002\u9AD8\u5C42\u5BF9\u6B64\u8868\u793A\u8D5E\u8D4F\uFF0C\u8BA4\u4E3A\u8FB9\u754C\u59D4\u6258\u6240\u8FD1\u671F\u7684\u52E4\u52C9\u5DE5\u4F5C\u8D77\u5230\u4E86\u5173\u952E\u4F5C\u7528\u3002"
  - "\u7075\u589F\u964D\u4E0B\u4E86\u4E00\u9635\u6CA1\u6709\u6E29\u5EA6\u7684'\u5149\u96E8'\u3002\u4ECA\u5929\u9012\u4EA4\u4E0A\u6765\u7684\u5408\u89C4\u6587\u8BC1\u90FD\u6CDB\u7740\u6DE1\u6DE1\u7684\u5FAE\u5149\u3002"
  purityHigh:
  - "\u4E3A\u4E86\u8868\u5F70\u8FD1\u671F\u5BF9\u5584\u610F\u7075\u4F53\u7684\u59A5\u5584\u5B89\u7F6E\uFF0C\u4E4C\u6258\u90A6\u964D\u4E0B\u4E86\u4E00\u573A\u7F55\u89C1\u7684'\u5149\u96E8'\u3002\u8BB8\u591A\u4E45\u75C5\u4E0D\u6108\u7684\u5C45\u6C11\u79F0\uFF0C\u4ED6\u4EEC\u611F\u5230\u8EAB\u4F53\u6B63\u5728\u9010\u6E10\u5EB7\u590D\u3002"
