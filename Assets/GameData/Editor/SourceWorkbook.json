      },
      "6": {
        "A": "F005",
        "B": "二、审批结算",
        "C": "反乌托邦表层变化",
        "D": "秩序值变化 = (记忆 - 关系 - 欲望 - 意志) / 10",
        "E": "每日闭馆时累加所有NPC的数值变化"
      },
      "7": {
        "A": "F006",
        "B": "二、审批结算",
        "C": "表层值每日恢复",
        "D": "若当前值<50，当日闭馆后自动+1，上限为50",
        "E": "每日无上下限限制，自然累加，闭馆时回归"
      },
      "8": {
        "A": "F007",
        "B": "三、收容所机制",
        "C": "收容所属性腐化",
        "D": "每天闭馆时：记忆-1，关系-1，欲望+1，意志+1",
        "E": "取消精神值。属性直接腐化，关得越久越危险。"
      },
      "9": {
        "A": "F008",
        "B": "三、收容所机制",
        "C": "变异判定",
