      "18": {
        "A": "生成阶段（后台静默进行）"
      },
      "19": {
        "A": "1.掷骰子（表6）：按权重随机生成NPC的4个底层数值（-10~10）：记忆、关系、欲望、意志。"
      },
      "20": {
        "A": "2.转等级（表1）：把数值转成1~5级。"
      },
      "21": {
        "A": "3.生成真实档案（表2、表3）：",
        "D": "查表3：生成四个一维定性（记忆残留、情感牵系、内在渴求、反抗意志） + 真实身体状态（desire_body）。"
      },
      "22": {
        "D": "查表2：生成二维标签（比如“深渊回溯者”、“被异化的工具”）。"
      },
      "23": {
        "A": "4.生成真实动机（表4）：根据极端属性，决定NPC的真实目的（如“追随羁绊”）。"
      },
      "24": {
        "A": "5.计算欺骗度（公式F003）：根据真实属性与动机的偏差，算出 0诚实 / 1粉饰 / 2欺骗。"
      },
      "25": {
        "A": "6.生成通关文书（表5）：根据动机、目的地、欺骗度，拼出两份文本：伪装的“身体状况” 和 伪装的“入境理由”。"
      },
      "26": {
        "A": "7.生成伪装身份信息：随机或根据剧本生成假的“原籍”（如林默真实的第七工业区，文书上写第九机械厂）。"
      },
      "29": {
        "A": "玩家审批阶段（表现层交互）"
      },
      "30": {
        "A": "UI展示：屏幕左边是《通关文书》（伪造），右边是《人物档案》（真实）。"
      },
      "31": {
        "A": "玩家操作：点击“放行（乌托邦）”、“放行（反乌托邦）”或“拒签（关收容所）”。"
      },
      "32": {
        "A": "结算世界数值（公式F004/F005）："
      },
      "33": {
        "A": "放行乌托邦：纯净值 += (记忆 + 关系 - 欲望 - 意志) / 10。"
      },
      "34": {
        "A": "放行反乌托邦：秩序值 += (记忆 - 关系 - 欲望 - 意志) / 10。"
      },
      "35": {
        "A": "拒签：NPC进入收容所。"
      },
      "38": {
        "A": "日终结算（每天闭馆时触发）"
      },
      "39": {
        "A": "收容所腐化（公式F007）：收容所内所有NPC：记忆-1，关系-1，欲望+1，意志+1。"
      },
      "40": {
        "A": "变异判定（公式F008）：如果（欲望>=10 且 意志>=10），标记为变异。"
      },
      "41": {
        "A": "自然恢复（公式F006）：纯净值、秩序值<50则自动+1，上限50。"
      },
      "42": {
        "A": "黑天鹅事件（公式F011/F012）：若纯净或秩序<=30，触发3天倒计时，每天扣10，且收容所NPC额外欲望+2、意志+2。"
      },
      "43": {
        "A": "日终结算（公式F013/F014/F015）："
      },
      "44": {
        "A": "信任值 = 原信任值 + 合规放行×5 - 违规放行×10 + 5。"
      },
      "45": {
        "A": "检查游戏结束：信任<=0 或 纯净<=20 或 秩序<=20。"
      },
      "46": {
        "A": "天数+1，生成下一个NPC。"
      }
    },
