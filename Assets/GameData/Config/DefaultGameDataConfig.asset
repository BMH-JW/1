      text: "\u3010\u8C03\u8BD5\u4E8B\u5B9E\u3011\u7B2C{day}\u5929\uFF0C{name}\u7684{choice}\u5DF2\u7ED3\u7B97\u3002\u8BE5\u6B21{utopia}\u8BB0\u8D26{purityDelta}\uFF0C{anti_utopia}\u8BB0\u8D26{orderDelta}\uFF1B\u5F53\u65E5\u5B9E\u9645\u51C0\u53D8\u5316\u5206\u522B\u4E3A{actualPurityDelta}\u3001{actualOrderDelta}\u3002"
