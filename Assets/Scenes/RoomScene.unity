  m_Name: 
  m_EditorClassIdentifier: 
  guideNpcSprite: {fileID: 0}
  typingInterval: 0.06
  welcomeText: "\u6B22\u8FCE\u6765\u5230\u5BA1\u6279\u7AD9\u3002\u6211\u4F1A\u4E00\u6B65\u6B65\u6559\u4F60\u8FD9\u91CC\u7684\u5DE5\u4F5C\u89C4\u5219\u3002"
  welcomeText2: "\u8DDF\u7740\u91D1\u8272\u9AD8\u4EAE\u63D0\u793A\u64CD\u4F5C\uFF0C\u5373\u53EF\u5B8C\u6210\u57FA\u7840\u5F15\u5BFC\u3002"
  bell:
    target: {fileID: 0}
    findName: Btn_Bell
  btn7Rules:
    target: {fileID: 0}
    findName: Btn_7
  btn6Info:
    target: {fileID: 0}
    findName: Btn_6
  npcGuest:
    target: {fileID: 0}
    findName: NPC
  mailbox:
    target: {fileID: 0}
    findName: MailBox,MailBox2
  profile:
    target: {fileID: 0}
    findName: Btn_File3
  document:
    target: {fileID: 0}
    findName: Btn_File2
  stamp1:
    target: {fileID: 0}
    findName: Btn_Stamp1
  stamp2:
    target: {fileID: 0}
    findName: Btn_Stamp2
  phone:
    target: {fileID: 0}
    findName: Btn_TelePhone
  screen:
    target: {fileID: 0}
    findName: InfoScreen
  clock:
    target: {fileID: 0}
    findName: Clock
  bubbleSize: {x: 560, y: 160}
  btn7RulesText: "\u8BF7\u67E5\u770B\u4ECA\u65E5\u7684\u5BA1\u67E5\u89C4\u5219"
  btn6InfoText: "\u53EF\u4EE5\u67E5\u770B\u4FE1\u606F"
  bellText: "\u70B9\u51FB\u94C3\u94DB\uFF0C\u547C\u53EB\u5BA2\u4EBA\u524D\u6765"
  mailBoxText: "\u70B9\u51FB\u7EB8\u76D2\uFF0C\u67E5\u770B\u5BA2\u4EBA\u643A\u5E26\u7684\u7269\u54C1\u4FE1\u606F"
  profileText: "\u6253\u5F00\u4EBA\u7269\u6863\u6848\u4E0E\u901A\u5173\u6587\u4E66\uFF0C\u53EF\u8FDB\u884C\u62D6\u62FD\u79FB\u52A8\uFF0C\u5E76\u5BF9\u5176\u4E00\u4E00\u67E5\u9605"
  documentText: "\u67E5\u770B\u5BA1\u6279\u89C4\u5219\uFF1A\u9009\u62E9\u5BF9\u4E16\u754C\u5F71\u54CD\u66F4\u5C0F\u7684\u65B9\u6848\u5373\u4E3A\u6B63\u786E\u5BA1\u6279"
  stampsText: "\u4E24\u679A\u5370\u7AE0\u4EE3\u8868\u4F60\u7684\u5BA1\u6279\u9009\u62E9\uFF0C\u8C28\u614E\u505A\u51FA\u51B3\u5B9A"
  phoneText: "\u9047\u5230....\u60C5\u51B5\uFF0C\u53EF\u4EE5\u9009\u62E9\u6263\u7559\uFF0C\u70B9\u51FB\u7535\u8BDD\u786E\u8BA4\u64CD\u4F5C"
  screenText: "\u5728\u8FD9\u91CC\u67E5\u770B\u4E8B\u4EF6\u4E0E\u5404\u4E2A\u4E16\u754C\u7684\u80CC\u666F\u4FE1\u606F"
  clockText: "\u6CE8\u610F\u65F6\u95F4\u6D41\u901D\uFF0C\u52A1\u5FC5\u5728\u4E0B\u73ED\u524D\u5B8C\u6210\u5BA1\u6279"
  bubbleSpriteOverride: {fileID: -248906351, guid: 71977118936b63f4bbf8b3a46906ea68, type: 3}
