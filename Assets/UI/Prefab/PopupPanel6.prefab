  contentLegacy: {fileID: 0}
  closeBtnSprite: {fileID: 21300000, guid: 7560980f2e0eb7b41b3d2d5e60c050d8, type: 3}
  pinCloseBtnTopRight: 1
  closeBtnTopRightOffset: {x: -17.8, y: -16}
  systemFontName: Microsoft YaHei
  titleOverrideFontSize: 0
  titleFontSize: 28
  titleOverridePosition: 0
  titleAnchoredPosition: {x: 0, y: 0}
  titleOverrideSize: 0
  titleSizeDelta: {x: 0, y: 0}
  contentOverrideFontSize: 1
  contentFontSize: 15
  contentOverridePosition: 1
  contentAnchoredPosition: {x: 6.6, y: -175.8}
  contentOverrideSize: 1
  contentSizeDelta: {x: 443.4, y: 283.6}
  documentFields: []
  dragToFront: 1
  clickToNextPage: 1
  clickPageTexts:
  - "\u3010\u7B7E\u53D1\u673A\u6784\u3011\u7075\u589F\u8FB9\u68C0\u53F8\r\n\r\n\u3010\u6587\u4EF6\u7F16\u53F7\u3011SPT-STABLE-001\r\n\r\n\u3010\u7248\u672C\u53F7\u3011V1.0\uFF08\u521D\u59CB\u6001\uFF09\r\n\r\n\u3010\u6838\u5FC3\u5B97\u65E8\u3011\u7EF4\u6301\u7A33\u5B9A\uFF0C\u51CF\u5C11\u6270\u52A8\uFF0C\u4FDD\u969C\u7075\u589F\u7684\u6301\u7EED\u8FD0\u884C\u3002\r\n\r\n\u5BA1\u67E5\u539F\u5219\r\n\r\n\u7B2C\u4E00\u6761\r\n\r\n\u7075\u589F\u4EE5\u7A33\u5B9A\u4E3A\u5B58\u7EED\u4E4B\u672C\u3002\u5F3A\u70C8\u7684\u6267\u5FF5\u4E0E\u65E0\u6CD5\u5E73\u606F\u7684\u60C5\u7EEA\uFF0C\u53EF\u80FD\u4F7F\u4E2A\u4F53\u957F\u671F\u505C\u7559\u4E8E\u8FC7\u53BB\uFF0C\u5E76\u5BF9\u5468\u906D\u4EA7\u751F\u96BE\u4EE5\u9884\u6599\u7684\u5F71\u54CD\u3002\u5BA1\u67E5\u5B98\u5E94\u7406\u89E3\uFF0C\u5E73\u9759\u5E76\u975E\u6BEB\u65E0\u610F\u4E49\uFF0C\u800C\u662F\u7075\u589F\u5F97\u4EE5\u7EF4\u7CFB\u7684\u5FC5\u8981\u6761\u4EF6\u3002\r\n\r\n\u7B2C\u4E8C\u6761\r\n\r\n\u7075\u589F\u63A5\u7EB3\u5F52\u5BA2\uFF0C\u5E76\u975E\u4E3A\u4E86\u5EF6\u7EED\u5176\u751F\u524D\u7684\u4E00\u5207\u3002\u90E8\u5206\u8BB0\u5FC6\u3001\u60C5\u611F\u4E0E\u6267\u7740\uFF0C\u5C06\u5728\u8DE8\u8D8A\u8FB9\u754C\u540E\u9010\u6E10\u5931\u53BB\u539F\u6709\u7684\u610F\u4E49\u3002\u5BF9\u6B64\u4E0D\u5FC5\u8FC7\u5EA6\u8FFD\u95EE\uFF0C\u4EA6\u4E0D\u5E94\u8F7B\u6613\u5C06\u5176\u89C6\u4E3A\u635F\u5931\u3002\r\n\r\n
    \u5BA1\u67E5\u63D0\u793A\r\n\r\n\u90E8\u5206\u5F52\u5BA2\u5728\u5B8C\u6210\u8DE8\u754C\u540E\uFF0C\u4F1A\u5BF9\u66FE\u7ECF\u73CD\u89C6\u7684\u4E8B\u7269\u8868\u73B0\u51FA\u964C\u751F\u611F\u3002\u6B64\u7C7B\u73B0\u8C61\u5DF2\u6709\u8BB0\u5F55\uFF0C\u4F46\u5176\u5177\u4F53\u539F\u56E0\u4E0D\u5C5E\u4E8E\u8FB9\u68C0\u53F8\u7684\u804C\u8D23\u8303\u56F4\u3002\r\n\r\n\u7A33\u5B9A\u72B6\u6001\u4E0B\u7684\u7075\u589F\u4E0D\u9700\u8981\u989D\u5916\u8BC1\u660E\u81EA\u8EAB\u7684\u7A33\u5B9A\u3002\u82E5\u67D0\u65E5\u4E00\u5207\u90FD\u663E\u5F97\u8FC7\u5206\u5E73\u9759\uFF0C\u8BF7\u4F9D\u7167\u73B0\u884C\u6D41\u7A0B\u7EE7\u7EED\u5DE5\u4F5C\u3002"
  - "\u3010\u7B7E\u53D1\u673A\u6784\u3011\u5E9F\u589F\u8FB9\u68C0\u53F8\r\n\r\n\u3010\u6587\u4EF6\u7F16\u53F7\u3011WST-ORDER-001\r\n\r\n\u3010\u7248\u672C\u53F7\u3011V1.0\uFF08\u521D\u59CB\u6001\uFF09\r\n\r\n\u3010\u6838\u5FC3\u5B97\u65E8\u3011\u7EF4\u6301\u79E9\u5E8F\uFF0C\u4FDD\u969C\u8FB9\u754C\u7A33\u5B9A\uFF0C\u907F\u514D\u65E2\u6709\u89C4\u5219\u5931\u6548\u3002\r\n\r\n\u5BA1\u67E5\u539F\u5219\r\n\r\n\u7B2C\u4E00\u6761\r\n\r\n\u5E9F\u589F\u5E76\u975E\u59CB\u7EC8\u5B89\u5B9A\u4E4B\u5730\u3002\u6B32\u671B\u3001\u6267\u5FF5\u4E0E\u672A\u7ADF\u4E4B\u4E8B\uFF0C\u66FE\u4F7F\u65E0\u6570\u65E2\u5B9A\u79E9\u5E8F\u8D70\u5411\u5D29\u584C\u3002\u5BA1\u67E5\u5B98\u5E94\u8C28\u8BB0\uFF0C\u7EF4\u6301\u79E9\u5E8F\u5E76\u975E\u6D88\u9664\u4E00\u5207\u7EB7\u4E89\uFF0C\u800C\u662F\u786E\u4FDD\u7EB7\u4E89\u4E0D\u4F1A\u8D8A\u8FC7\u65E0\u6CD5\u633D\u56DE\u7684\u754C\u9650\u3002\r\n\r\n\u7B2C\u4E8C\u6761\r\n\r\n\u6BCF\u4E00\u4F4D\u8DE8\u8D8A\u8FB9\u754C\u7684\u5F52\u5BA2\uFF0C\u90FD\u5E94\u6709\u5176\u5BF9\u5E94\u7684\u5F52\u5C5E\u3002\u672A\u7ECF\u8BB8\u53EF\uFF0C\u4E0D\u5F97\u64C5\u81EA\u6539\u53D8\u65E2\u5B9A\u6D41\u7A0B\u3002\u4E2A\u4F53\u7684\u613F\u671B\u503C\u5F97\u8BB0\u5F55\uFF0C\u4F46\u613F\u671B\u672C\u8EAB\u5E76\u4E0D\u6784\u6210\u6539\u53D8\u89C4\u5219\u7684\u7406\u7531\u3002\r\n\r\n\u5BA1\u67E5\u63D0\u793A\r\n\r\n\u5E9F\u589F\u7684\u5386\u53F2\u4E2D\uFF0C\u66FE\u6709\u8BB8\u591A\u4E8B\u7269\u56E0\u65E0\u4EBA\u7EA6\u675F\u800C\u5931\u53BB\u539F\u672C\u7684\u5F62\u6001\u3002\u90E8\u5206\u65E7\u6863\u6848\u81F3\u4ECA\u4ECD\u4FDD\u7559\u7740\u65E0\u6CD5\u89E3\u91CA\u7684\u7A7A\u767D\u3002\r\n\r\n\u79E9\u5E8F\u7684\u5B58\u5728\u662F\u4E3A\u4E86\u8BA9\u4E16\u754C\u7EE7\u7EED\u8FD0\u8F6C\u3002\u4F46\u8BF7\u52FF\u5C06\u201C\u4ECD\u5728\u8FD0\u8F6C\u201D\u89C6\u4E3A\u4E00\u5207\u6B63\u5E38\u7684\u8BC1\u660E\u3002"
